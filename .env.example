# Banco de dados (Postgres recomendado; funciona também com SQLite em dev trocando o provider no schema.prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/saas_frelance"

# Segredo usado para autenticar chamadas ao endpoint de sincronização (/api/sync).
# Na Vercel, definir essa env var com esse nome faz o próprio Vercel Cron
# enviar o header Authorization automaticamente. Gere um valor forte, ex:
# openssl rand -hex 32
CRON_SECRET="troque-por-um-segredo-forte"

# --- Freelancer.com ---
# API pública de projetos não exige OAuth para buscas simples, mas um token
# aumenta o rate limit. Ver: https://developers.freelancer.com/
FREELANCER_OAUTH_TOKEN=""

# --- Upwork ---
# A API oficial da Upwork exige um app aprovado e OAuth2. Sem essas credenciais
# o conector da Upwork fica desativado (retorna lista vazia com aviso no log).
# Ver: https://developers.upwork.com/
UPWORK_CLIENT_ID=""
UPWORK_CLIENT_SECRET=""
UPWORK_ACCESS_TOKEN=""

# --- Workana / 99Freelas ---
# Não possuem API pública oficial; os conectores fazem scraping das páginas
# públicas de busca. Ajuste USER_AGENT se necessário.
SCRAPER_USER_AGENT="Mozilla/5.0 (compatible; SaasFrelanceBot/0.1; +https://github.com/Naall-Bernardes/SAAS-FRELANCE)"
